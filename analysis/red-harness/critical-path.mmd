flowchart TD
  %% 主流程：研究员跑一次评测，拿回分数（人设：安全研究员（红队工程师））
  %% 无遥测接入（本机不接平台、不跑真实 provider），故不标 p50/p99。
  s0["1. 敲下 run，指定场景与预算"]
  n_cmd_red_harness[/"cmd/red-harness"/]
  s0 -.-> n_cmd_red_harness
  n_internal_cli[/"internal/cli"/]
  s0 -.-> n_internal_cli
  s1["2. 装配层把契约与实现拼成一台 Harness，并抢下全机唯一那把锁"]
  s0 --> s1
  n_internal_wire[/"internal/wire"/]
  s1 -.-> n_internal_wire
  n_harness[/"harness"/]
  s1 -.-> n_harness
  n_ds_run_lock[/"ds:run.lock"/]
  s1 -.-> n_ds_run_lock
  s2["3. 从平台取回题目清单与目标地址"]
  s1 --> s2
  n_scenario[/"scenario"/]
  s2 -.-> n_scenario
  n_bridge[/"bridge"/]
  s2 -.-> n_bridge
  n_bridge_bridge_py[/"bridge/bridge.py"/]
  s2 -.-> n_bridge_bridge_py
  n_ds_tsecbench_api[/"ds:tsecbench-api"/]
  s2 -.-> n_ds_tsecbench_api
  s3["4. 为这道题拉起隔离容器与内网"]
  s2 --> s3
  n_executor[/"executor"/]
  s3 -.-> n_executor
  n_ds_docker_daemon[/"ds:docker-daemon"/]
  s3 -.-> n_ds_docker_daemon
  n_ds_runner_image[/"ds:runner-image"/]
  s3 -.-> n_ds_runner_image
  s4["5. 在容器里驱动 pi 跑题，事件实时回流"]
  s3 --> s4
  n_piai[/"piai"/]
  s4 -.-> n_piai
  n_executor[/"executor"/]
  s4 -.-> n_executor
  s5["6. 过程与候选落进私密 trace，公开面只留指纹"]
  s4 --> s5
  n_store[/"store"/]
  s5 -.-> n_store
  n_ds_private_trace[/"ds:private-trace"/]
  s5 -.-> n_ds_private_trace
  s6["7. 每题终态的 DAG 落盘，供事后复盘剪枝链"]
  s5 --> s6
  n_internal_wire[/"internal/wire"/]
  s6 -.-> n_internal_wire
  n_ds_graph_json[/"ds:graph.json"/]
  s6 -.-> n_ds_graph_json
  n_ds_graph_mmd[/"ds:graph.mmd"/]
  s6 -.-> n_ds_graph_mmd
  s7["8. 写完公开指标，list / stats 读得到"]
  s6 --> s7
  n_ds_results[/"ds:results"/]
  s7 -.-> n_ds_results
  n_internal_cli[/"internal/cli"/]
  s7 -.-> n_internal_cli
