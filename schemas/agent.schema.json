{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-harness.local/schemas/agent.schema.json",
  "title": "Red Harness Agent",
  "type": "object",
  "required": ["apiVersion", "id", "type"],
  "properties": {
    "apiVersion": {"const": "redharness/v1"},
    "id": {"type": "string", "minLength": 1},
    "type": {"enum": ["cli", "docker", "pi"]},
    "command": {"type": "array", "items": {"type": "string"}},
    "cwd": {"type": ["string", "null"]},
    "env": {"type": "object", "additionalProperties": {"type": "string"}},
    "image": {"type": ["string", "null"]},
    "network": {"enum": ["environment", "none"]},
    "runtime": {"type": ["string", "null"], "minLength": 1},
    "pi": {
      "type": ["object", "null"],
      "properties": {
        "binary": {"type": "string", "minLength": 1},
        "launcher_args": {"type": "array", "items": {"type": "string"}},
        "provider": {"type": ["string", "null"]},
        "model": {"type": "string", "minLength": 1},
        "thinking": {
          "type": ["string", "null"],
          "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max", null]
        },
        "tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "approve_project": {"type": "boolean"},
        "context_files": {"type": "boolean"},
        "extensions": {"type": "boolean"},
        "skills": {"type": "boolean"},
        "prompt_templates": {"type": "boolean"},
        "themes": {"type": "boolean"},
        "mcp": {"type": "boolean"},
        "offline": {"type": "boolean"},
        "env_passthrough": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "cap_add": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "extra_args": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["model"],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
