{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://red-harness.local/schemas/policy.schema.json",
  "title": "Red Harness Gateway Policy",
  "type": "object",
  "properties": {
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "denied_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "max_tool_output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 1048576
    },
    "max_file_write_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    }
  },
  "additionalProperties": false
}
